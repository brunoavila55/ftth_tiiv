# ==============================================================================
# FTTH Manager — Exemplo de Configuração de Ambiente
# Copie este arquivo para .env e altere as credenciais conforme seu ambiente.
# NUNCA comite arquivos .env contendo segredos de produção no repositório.
# ==============================================================================

# Ambiente: development, test, production
ENVIRONMENT=development
APP_NAME="FTTH Manager"
LOG_LEVEL=INFO

# Segurança e Criptografia
# Os valores abaixo são PLACEHOLDERS: com ENVIRONMENT=production o backend RECUSA subir com eles
# (e o compose exige que as variáveis estejam definidas). Gere valores reais:
#   CSRF_SECRET:               openssl rand -hex 32
#   METRICS_SECRET_TOKEN:      openssl rand -hex 16   (mínimo de 32 caracteres)
COOKIE_SECURE=false
CSRF_SECRET=change-me-generate-with-openssl-rand-hex-32

# Backup: BACKUP_SIGNING_KEY assina o manifesto (HMAC-SHA256; obrigatória — openssl rand -hex 32) e
# BACKUP_ENCRYPTION_KEY (opcional, recomendada) criptografa o pacote com AES-256-GCM (openssl rand
# -hex 32). Guarde as duas FORA do servidor de backup; sem a chave o backup não é restaurável.
BACKUP_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
BACKUP_ENCRYPTION_KEY=

# Métricas (/api/v1/metrics): token de scraping (cabeçalho X-Metrics-Token) ou sessão de admin.
# METRICS_ENABLED=false desliga o endpoint (responde 404).
METRICS_ENABLED=true
METRICS_SECRET_TOKEN=change-me-generate-with-openssl-rand-hex-16

# Prefixo da API
API_V1_PREFIX=/api/v1

# Banco de Dados PostgreSQL / PostGIS
POSTGRES_DB=ftth_manager
POSTGRES_USER=ftth_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ftth_user:change-me-postgres-password@127.0.0.1:5432/ftth_manager

# Pool de Conexões do Banco
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS/CSRF (origens permitidas em formato JSON list). O cabeçalho Origin das requisições de
# escrita é comparado por IGUALDADE EXATA (esquema+host+porta): em produção inclua a origem pública,
# ex.: ["https://ftth.exemplo.com.br"].
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Proxies reversos confiáveis (IPs/CIDRs, JSON list): só deles o backend aceita X-Forwarded-For/-Proto
# (IP de origem para o rate limit de login, esquema https para o CSRF). Vazio = ninguém.
# No compose o padrão já cobre as redes privadas do Docker onde o Caddy roda.
TRUSTED_PROXIES=[]

# Armazenamento Local de Anexos
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Proxy / TLS (Caddy)
# Domínio público: o Caddy obtém e renova o certificado (portas 80 e 443 abertas na internet) e
# ativa o HSTS. Padrão ":80" = HTTP puro (desenvolvimento ou TLS terminado por balanceador externo,
# que deve enviar X-Forwarded-Proto: https). Em produção inclua a origem https em CORS_ORIGINS.
# SITE_ADDRESS=ftth.exemplo.com.br

# ==============================================================================
# FTTH Manager — Exemplo de Configuração de Ambiente
# Copie este arquivo para .env e altere as credenciais conforme seu ambiente.
# NUNCA comite arquivos .env contendo segredos de produção no repositório.
# ==============================================================================

# Ambiente: development, test, production
ENVIRONMENT=development
APP_NAME="FTTH Manager"
DEBUG=false
LOG_LEVEL=INFO

# Segurança e Criptografia
# Gere uma chave aleatória e segura em produção: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-replace-in-production-minimum-32-chars-long
COOKIE_SECURE=false
CSRF_SECRET=dev-insecure-csrf-secret-replace-in-production

# Prefixo da API
API_V1_PREFIX=/api/v1

# Banco de Dados PostgreSQL / PostGIS
POSTGRES_DB=ftth_manager
POSTGRES_USER=ftth_user
POSTGRES_PASSWORD=ftth_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ftth_user:ftth_password@127.0.0.1:5432/ftth_manager

# Pool de Conexões do Banco
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS (origens permitidas em formato JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Armazenamento Local de Anexos
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

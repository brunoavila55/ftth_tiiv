# FTTH Manager - Variáveis de Ambiente do Frontend
# Não inclua senhas ou segredos em NEXT_PUBLIC_*

# URL pública da API consumida pelo navegador (relativa por padrão para utilizar proxy de sessão e cookies HttpOnly)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# URL interna do backend para rewrites em desenvolvimento ou container
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
